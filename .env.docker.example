# Copy to .env next to compose.yml and fill in. Compose reads this file twice:
# for the two build arguments, and as the container's environment.
#
#   cp .env.docker.example .env
#
# Never commit the filled-in copy. .dockerignore and .gitignore both keep it out.

# Baked into the client bundle while building. Changing either one needs a
# rebuild, not a restart.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Read at runtime. The pooler connection, with prepared statements off.
DATABASE_URL=

# The direct connection, used only by `pnpm db:migrate`. It is here so a
# migration can be run through the image; the server itself never touches it.
DATABASE_MIGRATION_URL=

TMDB_ACCESS_TOKEN=

# Kept out of the shared server environment on purpose: if this one is missing
# the assistant fails and everything else keeps working.
GOOGLE_GENERATIVE_AI_API_KEY=
