# Public template only. Copy to a private .env for Compose and fill every
# required value. Never commit real credentials or overwrite an existing .env.
# Use distinct, long, URL-safe random hex passwords for the new local database.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=

# Runtime-only auth configuration. Generate at least 32 random characters.
# Local browser origin; set https://butaca.lat before a separately approved
# production deployment. DNS verification needs no subsequent activation flag.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend sending key and the approved sender. Domain DNS is configured in
# Resend/DNS, not in application code or build arguments.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Butaca <no-reply@butaca.lat>"

TMDB_ACCESS_TOKEN=
# Optional: needed only for the AI chat.
GOOGLE_GENERATIVE_AI_API_KEY=

# Only for running Node/Drizzle outside Compose: supply explicitly reachable
# local PostgreSQL URLs. Compose constructs its own service-DNS connections;
# its private PostgreSQL service does not publish a host port.
DATABASE_URL=
DATABASE_MIGRATION_URL=
